# Copiar a .env y completar. NUNCA versionar .env.

# --- Base de datos (MySQL Server)
VALKERY_DB_URL=mysql+aiomysql://valkery:CAMBIAR@127.0.0.1:3306/valkery_gps
# Base para pytest (se borra y recrea en cada ejecución). Si falta, se saltan los tests de MySQL.
VALKERY_TEST_DB_URL=mysql+aiomysql://valkery:CAMBIAR@127.0.0.1:3306/valkery_gps_test
VALKERY_RAW_PACKET_RETENTION_DAYS=30

# --- Servidor GPS TCP
VALKERY_GPS_HOST=0.0.0.0
VALKERY_GPS_PORT=5027
VALKERY_GPS_IDLE_TIMEOUT_S=600
VALKERY_GPS_MAX_CONNECTIONS=50
VALKERY_GPS_MAX_FRAME_BYTES=65536

# --- Eventos (fase 3)
# Sin comunicación durante este tiempo → DEVICE_OFFLINE
VALKERY_EVENT_OFFLINE_AFTER_S=1800
VALKERY_EVENT_INACTIVITY_CHECK_S=60
# Hueco máximo entre registros para considerar un cambio de ignition como transición
VALKERY_EVENT_IGNITION_MAX_GAP_S=3600
# Margen (m) que hay que alejarse del borde para salir de una geocerca
VALKERY_GEOFENCE_MARGIN_M=25

# --- API
VALKERY_API_JWT_SECRET=CAMBIAR
VALKERY_API_JWT_EXPIRE_MIN=60
VALKERY_API_CORS_ORIGINS=http://localhost:5173

# --- Comandos
VALKERY_COMMANDS_ENABLED=false
VALKERY_COMMAND_TTL_S=60
