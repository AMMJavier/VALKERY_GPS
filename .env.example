# Copiar a .env y completar. NUNCA versionar .env.

# --- Base de datos (MySQL Server)
VALKERY_DB_URL=mysql+aiomysql://valkery:CAMBIAR@127.0.0.1:3306/valkery_gps

# --- Servidor GPS TCP
VALKERY_GPS_HOST=0.0.0.0
VALKERY_GPS_PORT=5027
VALKERY_GPS_IDLE_TIMEOUT_S=600
VALKERY_GPS_MAX_CONNECTIONS=50
VALKERY_GPS_MAX_FRAME_BYTES=65536

# --- API
VALKERY_API_JWT_SECRET=CAMBIAR
VALKERY_API_JWT_EXPIRE_MIN=60
VALKERY_API_CORS_ORIGINS=http://localhost:5173

# --- Comandos
VALKERY_COMMANDS_ENABLED=false
VALKERY_COMMAND_TTL_S=60
